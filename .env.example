# MyDNA runs with no configuration at all. Every value below is optional.
# Copy to `.env` only if you need to change a default.

# --- Index location -----------------------------------------------------
# Where the local ClinVar index lives. Default: data/clinvar.sqlite
# MYDNA_INDEX_PATH=data/clinvar.sqlite

# Use Postgres instead of SQLite. Overrides MYDNA_INDEX_PATH.
# Requires the extra: pip install "mydna[postgres]"
# MYDNA_DATABASE_URL=postgresql+psycopg://user:password@localhost/variant_summary

# --- Server -------------------------------------------------------------
# Bind address. Keep this on loopback: MyDNA has no authentication by design
# and must not be exposed to a network. See SECURITY.md.
# MYDNA_HOST=127.0.0.1
# MYDNA_PORT=8000

# --- Limits -------------------------------------------------------------
# Maximum accepted upload size, in bytes. Default: 67108864 (64 MB).
# MYDNA_MAX_UPLOAD_BYTES=67108864

# --- Sessions -----------------------------------------------------------
# Signs the session cookie used for CSRF protection. If unset, an ephemeral
# key is generated at startup, which is fine for local use.
# MYDNA_SECRET_KEY=
